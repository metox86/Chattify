## WebRTC ICE servers (PeerJS / RTCPeerConnection)
#
# Option A (recommended): provide a JSON array of RTCIceServer objects
# VITE_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turns:turn.example.com:5349"],"username":"user","credential":"pass"}]
#
# Option B: simple STUN/TURN vars (used if VITE_ICE_SERVERS is not set)
# VITE_STUN_URL=stun:stun.l.google.com:19302
# VITE_TURN_URL=turns:turn.example.com:5349
# VITE_TURN_USER=user
# VITE_TURN_CRED=pass

